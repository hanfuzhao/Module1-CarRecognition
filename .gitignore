# Data — keep metadata + result figures, drop big caches
data/processed/*
!data/processed/.gitkeep
data/raw/*
!data/raw/stanford-cars
data/raw/stanford-cars/*
!data/raw/stanford-cars/metadata.json
data/outputs/*.log
!data/outputs/.gitkeep

# Models — commit the small trained artifacts so the app runs on deploy
# (deep head ~4.6MB, classical ~1.4MB; the ResNet50 backbone is fetched at runtime)

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Logs
*.log
